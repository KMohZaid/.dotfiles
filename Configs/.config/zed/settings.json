// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "search": {
    "regex": true,
  },
  "document_symbols": "on",
  "document_folding_ranges": "off",
  "colorize_brackets": true,
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "indent_guides": {
    "line_width": 1,
    "active_line_width": 4,
    "coloring": "indent_aware",
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "toolbar": {
    "breadcrumbs": true,
  },
  "relative_line_numbers": "enabled",
  "snippet_sort_order": "inline",
  "sticky_scroll": {
    "enabled": true,
  },
  "autoscroll_on_clicks": false,
  "vertical_scroll_margin": 7.0,
  "which_key": {
    "enabled": true,
  },
  "show_wrap_guides": true,
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "cursor_blink": false,
  "agent_ui_font_size": 18.0,
  "agent_buffer_font_size": 16.0,
  "ui_font_weight": 350.0,
  "ui_font_family": ".ZedMono",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 350.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "redact_private_values": false,
  "use_system_path_prompts": true,
  "proxy": "",
  "calls": {
    "mute_on_join": true,
  },
  "agent": {
    "dock": "right",
    "show_turn_stats": true,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 17.0,
  "buffer_font_size": 15.0,
  "theme": "Catppuccin Mocha - No Italics",

  "languages": {
    "Python": {
      //"language_servers": ["..."],
      "language_servers": ["ruff", "pylsp"], // TODO: enable other like jedi completion and more
    },
  },
  "lsp": {
    "pylsp": {
      "settings": {
        "plugins": {
          // disable everything
          "pycodestyle": { "enabled": false },
          "pyflakes": { "enabled": false },
          "pylint": { "enabled": false },
          "rope_autoimport": { "enabled": false },
          "rope_completion": { "enabled": false },
          "mccabe": { "enabled": false },
          "yapf": { "enabled": false },
          "autopep8": { "enabled": false },
          "flake8": { "enabled": false },

          // enable Jedi features
          "jedi_completion": { "enabled": true, "fuzzy": true, "eager": true },
          "jedi_definition": { "enabled": true },
          "jedi_hover": { "enabled": true },
          "jedi_references": { "enabled": true },
          "jedi_signature_help": { "enabled": true },
          "jedi_symbols": { "enabled": true },
          "jedi_code_lens": { "enabled": true },

          // enable only mypy
          "pylsp_mypy": {
            "mypy_command": "${HOME}/.venv/bin/mypy",
            "dmypy_command": "${HOME}/.venv/bin/dmypy",
            "enabled": true,
            "live_mode": true,
            "strict": false,
          },
        },
      },
    },
  },
}
